# =============================================================================
# spec-reviewer — пример окружения.
# Скопируй файл в .env и заполни GENAPI_KEY (в .env.example ключ пустой).
# Секреты коммитить нельзя (.env в .gitignore).
# =============================================================================

# ----- Сервер и БД -----
APP_HOST=0.0.0.0
APP_PORT=8040
DATABASE_PATH=./app.db
MAX_DOC_TEXT_LENGTH=30000

# ----- Логи -----
# Файлы: logs/app.<YYYYMMDD-HH>.log и logs/error.<YYYYMMDD-HH>.log в корне
# проекта (ротация 6 ч, хранение 3 дня) — задаёт modules/logger.py.
LOG_LEVEL=INFO

# ----- LLM: параметры цепочки A→B→C (модель/ключ — GenAPI, см. ниже) -----
LLM_MODEL=gpt-4o-mini
LLM_TEMP_ANALYZE=0.1            # шаг A, температура
LLM_TEMP_GENERATE=0.3           # шаг B, температура
LLM_MAX_TOKENS=2048
# Строгий JSON через response_format (опционально; надёжность обеспечивают
# промпты и валидация в ai_chain.py). Включить: LLM_JSON_MODE=1
# LLM_JSON_MODE=0

# ----- GenAPI (читает готовый клиент modules.genapi) -----
# Секретный ключ — ТОЛЬКО в .env (файл в .gitignore). В .env.example пусто.
GENAPI_KEY=
GENAPI_MODEL_CHAT=gpt-4o-mini
GENAPI_CHAT_TEMPERATURE=0.3
GENAPI_CHAT_MAX_TOKENS=2048
GENAPI_HTTP_TIMEOUT=60
GENAPI_POLL_TIMEOUT=120
GENAPI_POLL_INTERVAL=2

# ----- langchain_module: выбор backend -----
LC_LLM_BACKEND=genapi
LC_MODEL=gpt-4o-mini
LC_TEMPERATURE=0.0