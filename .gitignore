data/

# Логи
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / ОС
.idea/
.vscode/
.DS_Store
Thumbs.db